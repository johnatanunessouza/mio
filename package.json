{
  "name": "mio-cli",
  "version": "1.12.0",
  "description": "A neutral, reusable Node.js CLI foundation",
  "keywords": [
    "cli",
    "nodejs",
    "agent-configuration"
  ],
  "homepage": "https://github.com/johnatanunessouza/mio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnatanunessouza/mio.git"
  },
  "bugs": {
    "url": "https://github.com/johnatanunessouza/mio/issues"
  },
  "license": "MIT",
  "author": "mio contributors",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mio": "./bin/mio.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    ".agents",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "lint": "eslint src/",
    "build": "node build.js",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/mio.js",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "check:pack-version": "node -e \"console.log(require('./package.json').version)\"",
    "changeset": "changeset",
    "release": "pnpm run release:ci",
    "release:ci": "pnpm run check:pack-version && pnpm exec changeset publish"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@inquirer/core": "11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@<=5.0.8": ">=5.0.9 <6",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1 <4",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.17": ">=3.3.17 <4"
    }
  }
}
